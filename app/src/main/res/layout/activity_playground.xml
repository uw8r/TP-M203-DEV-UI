<?xml version="1.0" encoding="utf-8"?><!-- Playground : écrivez ici le layout des exemples du cours -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp"
    tools:context=".PlaygroundActivity">

    <ToggleButton
        android:id="@+id/tglClim"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textOff="Clim : OFF"
        android:textOn="Clim : ON"
        android:textSize="20sp"/>
    <com.google.android.material.materialswitch.MaterialSwitch
        android:id="@+id/swSilence"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Mode Silencieux"
        android:textSize="22sp"/>
    <TextView
        android:id="@+id/txtEtat"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Clim eteinte, son active"
        android:textSize="22sp"
        />

</LinearLayout>
