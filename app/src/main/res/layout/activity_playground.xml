<?xml version="1.0" encoding="utf-8"?>
<!-- Playground : écrivez ici le layout des exemples du cours -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp"
    tools:context=".PlaygroundActivity">

    <CheckBox
        android:id="@+id/chkImpression"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Impression"
        android:textSize="22sp"/>
    <CheckBox
        android:id="@+id/chkCasque"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Casque audio"
        android:textSize="22sp"/>
    <CheckBox
        android:id="@+id/chkScanner"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Scanner"
        android:textSize="22sp"/>
    <Button
        android:id="@+id/btnCalculer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Calculer"/>
    <TextView
        android:id="@+id/txtResultat"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"/>
</LinearLayout>
